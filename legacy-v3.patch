+#if defined(PSX_LEGACY_EFFICIENT_PACING)
+        uint32_t us = legacy_pacing_sleep_us(now, p->next_deadline, freq, period);
+        if (us == 0) break;
+        psx_host_sleep_micros(us);
+#else
         uint32_t ms = frame_pacing_sleep_ms(now, p->next_deadline, freq, period);
         if (ms == 0) break;
         /* Waitable timer on Win32; usleep on Unix — not coarse Sleep/SDL_Delay. */
         psx_host_sleep_ms(ms);
+#endif
     }
