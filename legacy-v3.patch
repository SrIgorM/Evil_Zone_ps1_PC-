--- a/psxrecomp/runtime/src/frame_pacing.c
+++ b/psxrecomp/runtime/src/frame_pacing.c
@@ -22,6 +22,21 @@
     if (ms < 2) return 0;                      /* sub-2ms: spin instead */
     return (uint32_t)(ms - 1);                 /* undershoot; spin covers rest */
 }
+
+#if defined(PSX_LEGACY_EFFICIENT_PACING)
+/* Host-only wait policy: retain a 250us guard for scheduling jitter instead
+ * of burning the last 1-2ms of every frame. Deadlines and catch-up are unchanged. */
+static uint32_t legacy_pacing_sleep_us(uint64_t now, uint64_t deadline,
+                                      uint64_t freq, uint64_t period) {
+    if (now >= deadline || freq == 0) return 0;
+    uint64_t remaining = deadline - now;
+    if (remaining > period) remaining = period;
+    double us = (double)remaining * 1000000.0 / (double)freq;
+    if (us <= 350.0) return 0;
+    if (us > 1000000.0) us = 1000000.0;
+    return (uint32_t)(us - 250.0);
+}
+#endif
 
